<?xml version="1.0" encoding="utf-8"?>
<!--
  No INTERNET or broad-access permission is declared here (P1, P2 in
  docs/PRODUCT_PRINCIPLES.md). Any future manifest change touching
  permissions, exported components, or backup/data-extraction rules requires
  a THREAT_MODEL.md review before merging (AGENTS.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ML Kit's transitive metrics transport is not part of OpenLife's
         boundary. Keep the merged shipping manifest free of network access. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".OpenLifeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- The launcher opens the current source-list UI. It is exported
             because Android requires a launcher activity to be reachable. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The one exported intake activity (design §8/§11). Every incoming
          intent is re-validated in code regardless of this filter, since an
          exported activity can be started directly with an arbitrary
          intent. No other component in this app is exported.
        -->
        <activity
            android:name=".intake.IntakeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- ProfileInstaller's exported receiver is not part of OpenLife's
             boundary; release must expose only the two intentional activities. -->
        <receiver
            android:name="${profileInstallerReceiverClass}"
            tools:node="remove" />

    </application>

</manifest>
