<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenLife" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/openlife_paper</item>
        <item name="android:navigationBarColor">@color/openlife_paper</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.OpenLife.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/openlife_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenLife</item>
    </style>
</resources>
