    <string name="app_lock_title">App lock</string>
    <string name="app_lock_explanation">Ask for your fingerprint, face or screen lock before OpenLife shows anything. This is an access gate, not extra encryption: your items are encrypted the same way whether it is on or off.</string>
    <string name="app_lock_not_enrolled">App lock needs a screen lock. Set one in the system Settings app first, then turn app lock on here.</string>
    <string name="app_lock_unavailable">This device cannot verify you right now, so app lock cannot be turned on. Try again later.</string>
    <string name="app_lock_timeout_title">Lock after leaving OpenLife</string>
    <string name="app_lock_timeout_immediately">Immediately</string>
    <string name="app_lock_timeout_30s">After 30 seconds</string>
    <string name="app_lock_timeout_5m">After 5 minutes</string>
    <string name="app_lock_timeout_15m">After 15 minutes</string>
    <string name="app_lock_offer_title">Lock OpenLife too?</string>
    <string name="app_lock_offer_body">Anyone who can unlock this phone can open OpenLife. App lock asks for your fingerprint, face or screen lock again before OpenLife shows anything. It is an access gate, not extra encryption. You can change this later in Settings.</string>
