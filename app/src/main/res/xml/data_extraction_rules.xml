<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data-extraction rules, covering both cloud backup and
  device-to-device transfer separately, as required by
  docs/THREAT_MODEL.md / design R2. Vault content already lives under
  noBackupFilesDir. Its protection relies on the platform default for that
  directory plus allowBackup=false; the rules below exclude ordinary app-data
  domains. Physical device-transfer behaviour remains a verification gap and
  must be checked per manufacturer where feasible.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
