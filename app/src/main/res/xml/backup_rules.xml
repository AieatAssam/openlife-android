<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (pre-Android 12) full-backup rules. allowBackup is false, so this is
  a defence-in-depth statement, not the primary control. Everything under the
  app's data directories is explicitly excluded; nothing is included.
  See docs/THREAT_MODEL.md.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <!-- The vault is under noBackupFilesDir. Its protection relies on the
         platform default for that directory plus allowBackup=false; this
         legacy schema has no no_backup domain. Physical device-transfer
         behaviour remains a verification gap. -->
</full-backup-content>
